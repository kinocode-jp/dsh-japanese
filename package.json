{
  "name": "@kinocode/dsh-japanese",
  "version": "0.1.10",
  "description": "Japanese language and typography pack for DeepSeek Harness: 日本語 UI, complete dictionary, and Japanese-first fonts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-session-title": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-title-llm": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "license": "MIT",
  "author": "kinocode",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "locale",
    "japanese",
    "ja",
    "i18n",
    "font"
  ],
  "files": [
    "lib/**/*.js",
    "locale/**/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs",
    "check": "node tools/check.mjs",
    "review": "node tools/review.mjs export",
    "apply-review": "node tools/review.mjs import",
    "batches": "node tools/make-batches.mjs",
    "audit": "node tools/audit.mjs",
    "smoke": "node tools/smoke.mjs",
    "polish": "node tools/make-polish.mjs",
    "apply-polish": "node tools/apply-polish.mjs",
    "merge": "node tools/merge-out.mjs",
    "prepublishOnly": "node tools/check.mjs && node tools/build-client.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-title": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "^0.2.1-rc.2"
  }
}
